{
  "manifest_version": 3,
  "name": "BlayBus Task Helper",
  "version": "1.0.0",
  "description": "BlayBus에서 테스크를 빠르게 만들고 타이머를 시작/중지합니다.",
  "action": {
    "default_title": "BlayBus Task Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.blaybus.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.blaybus.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
